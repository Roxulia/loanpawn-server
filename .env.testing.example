APP_NAME=LonePawn
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# Use a persistent database because external load generators cannot share :memory: SQLite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lonepawn_test
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
MAIL_MAILER=array
TELEGRAM_NOTIFICATIONS_ENABLED=false

# Performance dataset size and deterministic credentials.
PERFORMANCE_SEED_TENANTS=3
PERFORMANCE_SEED_USERS_PER_TENANT=10
PERFORMANCE_SEED_CUSTOMERS_PER_TENANT=10000
PERFORMANCE_SEED_SLIPS=50000
PERFORMANCE_SEED_CHUNK_SIZE=500
PERFORMANCE_SEED_RANDOM_SEED=20260906
PERFORMANCE_SEED_PASSWORD=Performance123!
